# Copy to .env and adjust. docker compose reads this file automatically.
# Every setting maps to a field on vesper_common.config.Settings.

VESPER_ENVIRONMENT=development
VESPER_DEBUG=true

# FastAPI origin reached by the Next.js server in Docker Compose. Change it if
# the backend runs elsewhere, then rebuild web.
BACKEND_URL=http://backend:8000

# Postgres and Redis. The hostnames are the compose service names; use localhost when
# running a service directly on the host.
VESPER_DATABASE_URL=postgresql+psycopg://vesper:vesper@postgres:5432/vesper
VESPER_REDIS_URL=redis://redis:6379/0

# Change this before anything leaves a laptop. Every service validates tokens with it.
VESPER_JWT_SECRET=dev-only-change-me
VESPER_ACCESS_TOKEN_MINUTES=720
VESPER_REFRESH_TOKEN_DAYS=14
# Guest QR sessions are short-lived and scoped to one occupied room.
VESPER_GUEST_TOKEN_MINUTES=480

VESPER_PROPERTY_TIMEZONE=Asia/Kolkata
VESPER_CURRENCY=INR

# The three web surfaces.
VESPER_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- AI ---------------------------------------------------------------------------
# Seeder task generation only. The backend concierge setting below is separate.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Concierge generation runs on Groq's free API. Get a key at https://console.groq.com.
# Without one, every concierge question politely escalates to the front desk; nothing
# else is affected.
VESPER_GROQ_API_KEY=
# GET /guest-intel/concierge/models lists what your key can actually serve.
VESPER_CONCIERGE_MODEL=llama-3.3-70b-versatile

# A Nugen domain-aligned model, deployed for the GM digital-twin insight.
# Use scripts/nugen_align.py to start alignment with the resort operations corpus.
VESPER_NUGEN_API_KEY=
VESPER_NUGEN_ALIGNED_MODEL_ID=

# Local models, both off by default. Turning either on downloads weights on first use,
# which would block the first request that needs it — switch them on only with the
# weights already baked into the image.
VESPER_SENTIMENT_USE_TRANSFORMER=false
VESPER_CONCIERGE_USE_EMBEDDINGS=false

# Executors compute, log and score but never touch the world while this is on. The
# owner also toggles it from the UI; this is only the starting value.
VESPER_SHADOW_MODE_DEFAULT=false
