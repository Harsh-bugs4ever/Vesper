# Copy to .env.local. Next.js reads it automatically; NEXT_PUBLIC_ vars reach the browser.

# Browsers use the same-origin /backend proxy by default, including on phones.
# FastAPI origin reached by the Next.js server (no /backend suffix).
BACKEND_URL=http://127.0.0.1:8000
# Only set NEXT_PUBLIC_API_URL for an intentionally separate public API origin.
