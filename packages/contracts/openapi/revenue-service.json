              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Restore Rates",
        "tags": [
          "revenue"
        ]
      }
    },
    "/revenue/simulate": {
      "post": {
        "description": "What-if on live data. The response carries its own assumptions.",
        "operationId": "simulate_revenue_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRequest"
              }
            }
