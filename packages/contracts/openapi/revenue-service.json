        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ForecastOut"
                  },
                  "title": "Response Refresh Forecast Revenue Forecast Refresh Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Refresh Forecast",
        "tags": [
          "revenue"
        ]
      }
    },
    "/revenue/rate-card": {
      "get": {
        "description": "Every category, every night, with the forecast beside the price.",
        "operationId": "rate_card_revenue_rate_card_get",
        "parameters": [
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 90,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RateCardRow"
                  },
                  "title": "Response Rate Card Revenue Rate Card Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
